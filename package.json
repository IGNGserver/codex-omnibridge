{
  "name": "codex-omnibridge",
  "version": "0.1.1",
  "description": "Codex OmniBridge - Native Desktop Application with Electron and Rust Core",
  "main": "apps/electron/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "check:panel": "node scripts/check-icons.js && node scripts/check-panel-tokens.js && node scripts/check-panel-auth.js && node scripts/check-csp-identical.js",
    "verify:panel": "node tools/panel-verify/run.mjs"
  },
  "author": {
    "name": "Codex MultiProvider Contributors",
    "email": "contributors@codex-omnibridge.dev"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.codex.omnibridge",
    "productName": "Codex OmniBridge",
    "directories": {
      "output": "dist/electron"
    },
    "files": [
      "apps/electron/**/*",
      "apps/panel/**/*",
      "assets/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png",
      "extraFiles": [
        {
          "from": "target/release/codex-mp.exe",
          "to": "bin/codex-mp.exe"
        },
        {
          "from": "THIRD_PARTY_NOTICES.md",
          "to": "THIRD_PARTY_NOTICES.md"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "installer/windows/uninstaller.nsh",
      "artifactName": "codex-omnibridge-windows-${arch}-${version}-setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "extraFiles": [
        {
          "from": "target/release/codex-mp",
          "to": "bin/codex-mp"
        },
        {
          "from": "THIRD_PARTY_NOTICES.md",
          "to": "THIRD_PARTY_NOTICES.md"
        }
      ]
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Development",
      "maintainer": "Codex MultiProvider Contributors <contributors@codex-omnibridge.dev>",
      "extraFiles": [
        {
          "from": "target/release/codex-mp",
          "to": "bin/codex-mp"
        },
        {
          "from": "THIRD_PARTY_NOTICES.md",
          "to": "THIRD_PARTY_NOTICES.md"
        }
      ]
    },
    "deb": {
      "packageCategory": "utils",
      "priority": "optional",
      "afterRemove": "installer/linux/deb/postrm",
      "fpm": [
        "--before-remove",
        "installer/linux/deb/prerm"
      ]
    }
  }
}
