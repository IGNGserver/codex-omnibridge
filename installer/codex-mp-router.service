[Unit]
Description=Codex MultiProvider OmniBridge router
Documentation=https://github.com/IGNGserver/codex-multiprovider
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=CODEX_MP_REGISTRY=__REGISTRY_PATH__
ExecStart=__CLI_PATH__ --registry __REGISTRY_PATH__ router --port 8787 --endpoint-file __ENDPOINT_FILE__
Restart=on-failure
RestartSec=2s
KillSignal=SIGINT
UMask=0077
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
