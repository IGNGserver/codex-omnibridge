{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex MultiProvider",
  "version": "0.1.0",
  "identifier": "dev.codex.multiprovider",
  "build": {
    "frontendDist": ".."
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Codex MultiProvider",
        "width": 1100,
        "height": 780,
        "minWidth": 860,
        "minHeight": 640,
        "visible": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../../target/release/codex-mp": "codex-mp"
    },
    "linux": {
      "deb": {
        "files": {
          "../../../target/release/codex-mp": "/usr/bin/codex-mp"
        },
        "postInstallScript": "../../../installer/deb/post-install.sh",
        "preRemoveScript": "../../../installer/deb/pre-remove.sh"
      }
    },
    "icon": [
      "icons/icon.png"
    ]
  }
}
