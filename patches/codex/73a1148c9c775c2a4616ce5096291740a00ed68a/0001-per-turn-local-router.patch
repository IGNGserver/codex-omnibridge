@@ -0,0 +1,157 @@
+//! Per-turn logical model routing for the Codex MultiProvider integration.
+//!
+//! The Codex provider and thread remain `openai`. Only namespaced logical model
+//! ids are dispatched to the local Router. The Router endpoint is discovered
+//! through a private, mode-0600 endpoint file supplied by the integration
+//! launcher; no ChatGPT credential is read or forwarded on this path.
+
+use std::fmt;
+use std::fs;
+use std::net::IpAddr;
+use std::path::Path;
+
+use serde::Deserialize;
+use url::Url;
+
+const ENDPOINT_FILE_ENV: &str = "CODEX_MP_ROUTER_ENDPOINT_FILE";
+const ENDPOINT_SCHEMA_VERSION: u32 = 1;
+
+#[derive(Clone)]
+pub(crate) struct LocalRouterEndpoint {
+    pub(crate) base_url: String,
+    pub(crate) capability_token: String,
+}
+
+impl fmt::Debug for LocalRouterEndpoint {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter
+            .debug_struct("LocalRouterEndpoint")
+            .field("base_url", &self.base_url)
+            .field("capability_token", &"<redacted>")
+            .finish()
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum LogicalRoute {
+    Official,
+    LocalRouter,
+}
+
+#[derive(Debug, Deserialize)]
+struct EndpointFile {
+    schema_version: u32,
+    base_url: String,
+    capability_token: String,
+}
+
+impl LocalRouterEndpoint {
+    pub(crate) fn from_environment() -> Option<Self> {
+        let path = std::env::var_os(ENDPOINT_FILE_ENV)?;
+        match Self::load(Path::new(&path)) {
+            Ok(endpoint) => Some(endpoint),
+            Err(error) => {
+                tracing::warn!(path = %Path::new(&path).display(), %error, "ignoring invalid local Router endpoint");
+                None
+            }
+        }
+    }
+
+    fn load(path: &Path) -> Result<Self, String> {
+        let metadata = fs::metadata(path).map_err(|error| error.to_string())?;
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            if metadata.permissions().mode() & 0o077 != 0 {
+                return Err("endpoint file must not be accessible by other users".into());
+            }
+        }
+        let endpoint: EndpointFile =
+            serde_json::from_str(&fs::read_to_string(path).map_err(|error| error.to_string())?)
+                .map_err(|error| error.to_string())?;
+        if endpoint.schema_version != ENDPOINT_SCHEMA_VERSION
+            || endpoint.capability_token.trim().is_empty()
+        {
+            return Err("unsupported or incomplete endpoint file".into());
+        }
+        let parsed = Url::parse(&endpoint.base_url).map_err(|error| error.to_string())?;
+        if parsed.scheme() != "http"
+            || (parsed.path() != "" && parsed.path() != "/")
+            || !parsed
+                .host_str()
+                .is_some_and(|host| host == "localhost" || is_loopback(host))
+        {
+            return Err("endpoint must be an http loopback URL".into());
+        }
+        Ok(Self {
+            base_url: endpoint.base_url,
+            capability_token: endpoint.capability_token,
+        })
+    }
+}
+
+fn is_loopback(host: &str) -> bool {
+    host.parse::<IpAddr>()
+        .map(|address| address.is_loopback())
+        .unwrap_or(false)
+}
+
+pub(crate) fn route_for_model(model_id: &str) -> LogicalRoute {
+    if model_id.contains('/') {
+        LogicalRoute::LocalRouter
+    } else {
+        LogicalRoute::Official
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_namespaced_models_use_local_router() {
+        assert_eq!(route_for_model("gpt-5.6-sol"), LogicalRoute::Official);
+        assert_eq!(route_for_model("newapi/qwen3.8"), LogicalRoute::LocalRouter);
+    }
+
+    #[test]
+    fn loads_private_loopback_endpoint() {
+        let file = tempfile::NamedTempFile::new().expect("temporary endpoint file");
+        fs::write(
+            file.path(),
+            r#"{"schema_version":1,"base_url":"http://127.0.0.1:8787","capability_token":"test-token"}"#,
+        )
+        .expect("write endpoint file");
+        let endpoint = LocalRouterEndpoint::load(file.path()).expect("valid endpoint");
+        assert_eq!(endpoint.base_url, "http://127.0.0.1:8787");
+        assert_eq!(endpoint.capability_token, "test-token");
+        assert!(!format!("{endpoint:?}").contains("test-token"));
+    }
+
+    #[test]
+    fn rejects_non_loopback_endpoint() {
+        let file = tempfile::NamedTempFile::new().expect("temporary endpoint file");
+        fs::write(
+            file.path(),
+            r#"{"schema_version":1,"base_url":"https://provider.example/v1","capability_token":"test-token"}"#,
+        )
+        .expect("write endpoint file");
+        assert!(LocalRouterEndpoint::load(file.path()).is_err());
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn rejects_endpoint_file_readable_by_other_users() {
+        use std::os::unix::fs::PermissionsExt;
+
+        let file = tempfile::NamedTempFile::new().expect("temporary endpoint file");
+        fs::write(
+            file.path(),
+            r#"{"schema_version":1,"base_url":"http://127.0.0.1:8787","capability_token":"test-token"}"#,
+        )
+        .expect("write endpoint file");
+        fs::set_permissions(file.path(), fs::Permissions::from_mode(0o644))
+            .expect("set endpoint permissions");
+        assert!(LocalRouterEndpoint::load(file.path()).is_err());
+    }
+}
