+        let mut api_provider = self
+            .client
+            .state
+            .provider
+            .info()
+            .to_api_provider(/*auth_mode*/ None)?;
+        api_provider.name = "codex-mp-local-router".into();
+        api_provider.base_url = endpoint.base_url.clone();
+        api_provider.headers = ApiHeaderMap::new();
